{
  "name": "@emblemvault/mcp",
  "version": "1.1.0",
  "description": "Stdio MCP server that bridges to the hosted EmblemAI MCP at https://emblemvault.ai/api/mcp",
  "type": "module",
  "main": "index.js",
  "bin": {
    "emblemai-mcp": "index.js"
  },
  "scripts": {
    "start": "node index.js",
    "build": "esbuild index.js --bundle --platform=node --format=esm --target=node20 --outfile=dist/index.js"
  },
  "files": [
    "index.js",
    "dist/"
  ],
  "devDependencies": {
    "esbuild": "^0.27.0"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0"
  },
  "license": "MIT",
  "homepage": "https://emblemvault.ai",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/EmblemCompany/Agent-skills.git",
    "directory": "mcp-bridge"
  }
}
